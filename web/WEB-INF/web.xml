    </servlet-mapping>

    <!-- Định nghĩa servlet cho PayOSController -->
    <servlet>
        <servlet-name>PayOSController</servlet-name>
        <servlet-class>controller.PayOSController</servlet-class>
    </servlet>

    <!-- Ánh xạ servlet đến URL /payos/* -->
    <servlet-mapping>
        <servlet-name>PayOSController</servlet-name>
        <url-pattern>/payos/*</url-pattern>
    </servlet-mapping>

