    <servlet-mapping>
        <servlet-name>SpaServiceServlet</servlet-name>
        <url-pattern>/spa-service</url-pattern>
    </servlet-mapping>

    <!-- Định nghĩa servlet cho CartServlet -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>controller.CartServlet</servlet-class>
