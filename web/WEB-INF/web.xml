<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

    <!-- Order -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/orderservlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/admin/manage-order</url-pattern>
    </servlet-mapping>

    <!-- Toy Detail -->
    <servlet>
        <servlet-name>ToyDetailServlet</servlet-name>
        <servlet-class>controller.ToyDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ToyDetailServlet</servlet-name>
        <url-pattern>/toydetailservlet</url-pattern>
    </servlet-mapping>

    <!-- Spa Booking -->
    <servlet>
        <servlet-name>SpaBookingServlet</servlet-name>
        <servlet-class>controller.SpaBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpaBookingServlet</servlet-name>
        <url-pattern>/spa-booking</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SpaBookingServlet</servlet-name>
        <url-pattern>/spa-cart</url-pattern>
    </servlet-mapping>

    <!-- Spa Service -->
    <servlet>
        <servlet-name>SpaServiceServlet</servlet-name>
        <servlet-class>controller.SpaServiceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpaServiceServlet</servlet-name>
        <url-pattern>/spa-service</url-pattern>
    </servlet-mapping>

    <!-- Cart -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cartservlet</url-pattern>
    </servlet-mapping>

    <!-- Payment / PayOS -->
    <servlet>
        <servlet-name>ConfirmPaymentServlet</servlet-name>
        <servlet-class>controller.ConfirmPaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmPaymentServlet</servlet-name>
        <url-pattern>/confirmpaymentservlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PayOSController</servlet-name>
        <servlet-class>controller.PayOSController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PayOSController</servlet-name>
        <url-pattern>/payos/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PayOSWebhookServlet</servlet-name>
        <servlet-class>controller.PayOSWebhookServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PayOSWebhookServlet</servlet-name>
        <url-pattern>/payos/webhook</url-pattern>
    </servlet-mapping>

    <!-- Auth -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoogleLoginServlet</servlet-name>
        <servlet-class>controller.GoogleLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleLoginServlet</servlet-name>
        <url-pattern>/logingoogle</url-pattern>
    </servlet-mapping>

    <!-- Boarding -->
    <servlet>
        <servlet-name>BoardingRoomServlet</servlet-name>
        <servlet-class>controller.BoardingRoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BoardingRoomServlet</servlet-name>
        <url-pattern>/boarding-room</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BoardingRoomSimpleServlet</servlet-name>
        <servlet-class>controller.BoardingRoomSimpleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BoardingRoomSimpleServlet</servlet-name>
        <url-pattern>/boarding-room-simple</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <!-- Doctor Profile -->
    <servlet>
        <servlet-name>DoctorProfileController</servlet-name>
        <servlet-class>controller.DoctorProfileController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorProfileController</servlet-name>
        <url-pattern>/doctor/profile</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <!-- Khuyên dùng index.jsp rồi forward sang /home để chắc chắn -->
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
