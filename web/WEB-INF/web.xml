        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Định nghĩa servlet cho GoogleLoginServlet -->
    <servlet>
        <servlet-name>GoogleLoginServlet</servlet-name>
        <servlet-class>controller.GoogleLoginServlet</servlet-class>
    </servlet>

    <!-- Ánh xạ servlet đến URL /logingoogle -->
    <servlet-mapping>
        <servlet-name>GoogleLoginServlet</servlet-name>
        <url-pattern>/logingoogle</url-pattern>
    </servlet-mapping>


    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>
</web-app>
